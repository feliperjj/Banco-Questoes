/* Base ------------------------------------------------------------------ */
QWidget {
    background: #f4f7fb;
    color: #24324a;
    font-family: "Segoe UI", "Inter", Arial, sans-serif;
    font-size: 10pt;
}

QMainWindow, QDialog { background: #f4f7fb; }
QDialog { border: 1px solid #dce4f0; }
QLabel { background: transparent; }

/* Navigation ------------------------------------------------------------ */
QFrame#sidebar {
    background: #17233c;
    border: none;
}

QLabel#brand-title {
    color: #ffffff;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 1px;
}

QLabel#brand-subtitle, QLabel#sidebar-footer {
    color: #8f9db8;
    font-size: 9px;
    letter-spacing: 0.6px;
}

QLabel#sidebar-footer { padding: 10px 2px 0; }

QListWidget#main-menu {
    background: transparent;
    color: #b9c6df;
    border: none;
    outline: none;
    padding: 0;
}

QListWidget#main-menu::item {
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 12px 12px;
    margin: 3px 0;
}

QListWidget#main-menu::item:hover {
    background: #253657;
    color: #ffffff;
}

QListWidget#main-menu::item:selected {
    background: #4f7cff;
    color: #ffffff;
    font-weight: 600;
}

QStackedWidget#content-pages { background: #f4f7fb; }

/* Typography ------------------------------------------------------------ */
QLabel#dashboard-title {
    color: #17233c;
    font-size: 24px;
    font-weight: 750;
}

QLabel#page-title { color: #17233c; font-size: 20px; font-weight: 700; }

QLabel#dashboard-subtitle, QLabel#dashboard-details, QLabel#dashboard-status {
    color: #71809a;
}

QLabel#dashboard-status { font-size: 9pt; }
QLabel#exam-info { color: #34435f; font-size: 13px; font-weight: 650; }
QLabel#page-subtitle { color: #71809a; font-size: 10pt; }
QLabel#section-title { color: #24324a; font-size: 13px; font-weight: 700; padding-top: 4px; }
QLabel#timer-label {
    color: #315dcc;
    background: #eaf0ff;
    border: 1px solid #cbd8ff;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 15px;
    font-weight: 700;
}
QLabel#exam-progress-label, QLabel#review-progress-label { color: #71809a; font-size: 9pt; font-weight: 650; }
QLabel#exam-question-kicker, QLabel#review-kicker { color: #4f7cff; font-size: 9pt; font-weight: 800; letter-spacing: 1px; }
QFrame#exam-question-card, QFrame#review-card {
    background: #ffffff;
    border: 1px solid #e1e7f1;
    border-radius: 14px;
}
QFrame#exam-options-card, QFrame#review-options-card {
    background: #f8faff;
    border: 1px solid #e4eaf5;
    border-radius: 10px;
}
QTextEdit#exam-statement, QTextEdit#review-statement {
    background: #ffffff;
    border: none;
    color: #24324a;
    font-size: 12px;
    line-height: 1.45;
    padding: 4px;
}
QRadioButton#exam-option, QRadioButton#review-option {
    background: #ffffff;
    border: 1px solid #e0e7f2;
    border-radius: 8px;
    padding: 11px 12px;
    color: #34435f;
}
QRadioButton#exam-option:hover, QRadioButton#review-option:hover { border-color: #9fb5ee; background: #f4f7ff; }
QRadioButton#exam-option:checked, QRadioButton#review-option:checked { border: 2px solid #4f7cff; background: #edf2ff; color: #244fae; }
QProgressBar#exam-progress, QProgressBar#review-progress {
    background: #e7edf7;
    border: none;
    border-radius: 4px;
    height: 7px;
}
QProgressBar#exam-progress::chunk, QProgressBar#review-progress::chunk { background: #4f7cff; border-radius: 4px; }
QLabel#empty-state { color: #71809a; font-size: 12px; padding: 40px; }
QFrame#stat-card {
    background: #ffffff;
    border: 1px solid #e1e7f1;
    border-radius: 12px;
}
QLabel#stat-card-title { color: #71809a; font-size: 9pt; }
QLabel#stat-card-value { color: #17233c; font-size: 22px; font-weight: 750; padding-top: 4px; }
QWidget#chart-card { background: #ffffff; border: 1px solid #e1e7f1; border-radius: 12px; }

/* Dashboard ------------------------------------------------------------- */
QFrame#dashboard-card {
    background: #ffffff;
    border: 1px solid #e1e7f1;
    border-radius: 13px;
}

QFrame#dashboard-card:hover { border: 1px solid #b9c9ef; }
QLabel#dashboard-card-title { color: #71809a; font-size: 9pt; }
QLabel#dashboard-card-value { color: #17233c; font-size: 25px; font-weight: 750; }

/* Controls -------------------------------------------------------------- */
QPushButton {
    background: #4f7cff;
    color: #ffffff;
    border: 1px solid #4f7cff;
    border-radius: 8px;
    padding: 9px 16px;
    min-height: 18px;
    font-weight: 600;
}

QPushButton:hover { background: #3f68dc; border-color: #3f68dc; }
QPushButton:pressed { background: #3158c3; border-color: #3158c3; }
QPushButton:disabled { background: #c5cfdf; border-color: #c5cfdf; color: #f4f6fa; }
QPushButton#secondary-button { background: #ffffff; color: #405170; border-color: #ccd6e6; }
QPushButton#secondary-button:hover { background: #edf2fb; border-color: #aabbdc; }
QPushButton#danger-button { background: #d95362; border-color: #d95362; }
QPushButton#danger-button:hover { background: #bd3f4e; border-color: #bd3f4e; }
QPushButton#table-action-button { background: #eef3ff; color: #315dcc; border: 1px solid #cbd8ff; padding: 5px 10px; min-height: 0px; border-radius: 7px; font-size: 9pt; font-weight: 700; }
QPushButton#table-action-button:hover { background: #dfe8ff; border-color: #9fb5ee; }
QPushButton#table-action-button:pressed { background: #cbd8ff; }

QLineEdit, QTextEdit, QComboBox, QSpinBox {
    background: #ffffff;
    color: #24324a;
    border: 1px solid #d3dcea;
    border-radius: 8px;
    padding: 8px 10px;
    selection-background-color: #4f7cff;
    selection-color: #ffffff;
}

QTextEdit { padding: 10px; }
QLineEdit:hover, QTextEdit:hover, QComboBox:hover, QSpinBox:hover { border-color: #b7c5dd; }
QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QSpinBox:focus { border: 2px solid #6b8ff0; padding: 7px 9px; }
QComboBox::drop-down { width: 28px; border: none; }
QComboBox QAbstractItemView { background: #ffffff; border: 1px solid #ccd6e6; selection-background-color: #eaf0ff; selection-color: #24324a; }

/* Tables and lists ------------------------------------------------------ */
QTableWidget {
    background: #ffffff;
    alternate-background-color: #f8faff;
    color: #34435f;
    border: 1px solid #dfe6f0;
    border-radius: 10px;
    gridline-color: #edf1f7;
    outline: none;
    selection-background-color: #e6edff;
    selection-color: #24324a;
}

QTableWidget::item { padding: 8px; border-bottom: 1px solid #f0f3f8; }
QTableWidget::item { padding: 10px 12px; }
QTableWidget::item:selected { border-left: 3px solid #4f7cff; }
QHeaderView::section {
    background: #eef2f8;
    color: #52617b;
    border: none;
    border-bottom: 1px solid #dfe6f0;
    padding: 10px 8px;
    font-weight: 700;
}

QListWidget#import-list {
    background: #ffffff;
    color: #34435f;
    border: 1px solid #dfe6f0;
    border-radius: 10px;
    padding: 6px;
    outline: none;
}
QListWidget#import-list::item { border-radius: 7px; padding: 10px; }
QListWidget#import-list::item:hover { background: #f0f4fc; }
QListWidget#import-list::item:selected { background: #e6edff; color: #315dcc; }

/* Sections, scrollbars and feedback ------------------------------------ */
QGroupBox {
    background: #ffffff;
    border: 1px solid #dfe6f0;
    border-radius: 10px;
    margin-top: 14px;
    padding: 16px 12px 12px;
    font-weight: 700;
}
QGroupBox::title { subcontrol-origin: margin; left: 14px; padding: 0 6px; color: #34435f; background: #ffffff; }
QScrollArea { background: transparent; border: none; }
QScrollBar:vertical { background: #edf1f7; width: 10px; margin: 2px; border-radius: 5px; }
QScrollBar::handle:vertical { background: #b9c7dd; min-height: 30px; border-radius: 5px; }
QScrollBar::handle:vertical:hover { background: #91a6c8; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QToolTip { background: #17233c; color: #ffffff; border: 1px solid #2c416c; padding: 6px; }
